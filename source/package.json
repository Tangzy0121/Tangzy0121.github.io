{
  "name": "tangzy-terminal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "tsx scripts/build-content.ts",
    "dev": "tsx scripts/build-content.ts && vite",
    "build": "tsx scripts/build-content.ts && vite build && tsx scripts/deploy-local.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/build-content.ts && node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
